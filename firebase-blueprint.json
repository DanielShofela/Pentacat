{
  "entities": {
    "Category": {
      "title": "Category",
      "description": "Product categories in PENTA GAD Distribution",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "name": { "type": "string", "maxLength": 100 },
        "slug": { "type": "string", "maxLength": 100 },
        "description": { "type": "string", "maxLength": 500 },
        "imageUrl": { "type": "string", "maxLength": 1000 },
        "icon": { "type": "string", "maxLength": 50 },
        "displayOrder": { "type": "number" },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["name", "slug", "isActive"]
    },
    "Product": {
      "title": "Product",
      "description": "Products available in PENTA GAD catalog for direct purchase, installment, or tontine",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "reference": { "type": "string", "maxLength": 50 },
        "name": { "type": "string", "maxLength": 200 },
        "slug": { "type": "string", "maxLength": 200 },
        "shortDescription": { "type": "string", "maxLength": 1000 },
        "fullDescription": { "type": "string", "maxLength": 6000 },
        "description": { "type": "string", "maxLength": 3000 },
        "categoryId": { "type": "string", "maxLength": 64 },
        "categoryName": { "type": "string", "maxLength": 100 },
        "brand": { "type": "string", "maxLength": 100 },
        "model": { "type": "string", "maxLength": 100 },
        "price": { "type": "number" },
        "priceCash": { "type": "number" },
        "oldPrice": { "type": "number" },
        "promotionalPrice": { "type": "number" },
        "priceInstallment": { "type": "number" },
        "priceTontine": { "type": "number" },
        "stock": { "type": "number" },
        "status": { "type": "string", "maxLength": 50 },
        "images": { "type": "array" },
        "features": { "type": "array" },
        "warrantyMonths": { "type": "number" },
        "isCashEligible": { "type": "boolean" },
        "isInstallmentEligible": { "type": "boolean" },
        "isTontineEligible": { "type": "boolean" },
        "installmentMaxMonths": { "type": "number" },
        "installmentMinDepositPercent": { "type": "number" },
        "isActive": { "type": "boolean" },
        "isFeatured": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["reference", "name", "categoryId", "price", "stock"]
    },
    "Customer": {
      "title": "Customer",
      "description": "Customer profiles registered or synchronized with Auth",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "uid": { "type": "string", "maxLength": 128 },
        "fullName": { "type": "string", "maxLength": 150 },
        "email": { "type": "string", "maxLength": 150 },
        "phone": { "type": "string", "maxLength": 30 },
        "whatsappNumber": { "type": "string", "maxLength": 30 },
        "city": { "type": "string", "maxLength": 100 },
        "commune": { "type": "string", "maxLength": 100 },
        "address": { "type": "string", "maxLength": 300 },
        "idCardNumber": { "type": "string", "maxLength": 100 },
        "isVerified": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "fullName"]
    },
    "Order": {
      "title": "Order",
      "description": "Standard classic purchase orders",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "orderNumber": { "type": "string", "maxLength": 32 },
        "customerId": { "type": "string", "maxLength": 128 },
        "customerName": { "type": "string", "maxLength": 150 },
        "customerPhone": { "type": "string", "maxLength": 30 },
        "customerEmail": { "type": "string", "maxLength": 150 },
        "deliveryAddress": { "type": "string", "maxLength": 300 },
        "deliveryCity": { "type": "string", "maxLength": 100 },
        "deliveryCommune": { "type": "string", "maxLength": 100 },
        "items": { "type": "array" },
        "totalAmount": { "type": "number" },
        "paymentMethod": { "type": "string", "maxLength": 50 },
        "paymentStatus": { "type": "string", "maxLength": 50 },
        "orderStatus": { "type": "string", "maxLength": 50 },
        "source": { "type": "string", "maxLength": 50 },
        "notes": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["orderNumber", "customerName", "customerPhone", "items", "totalAmount", "orderStatus"]
    },
    "InstallmentContract": {
      "title": "InstallmentContract",
      "description": "Installment contracts for progressive payments",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "contractNumber": { "type": "string", "maxLength": 32 },
        "customerId": { "type": "string", "maxLength": 128 },
        "customerName": { "type": "string", "maxLength": 150 },
        "customerPhone": { "type": "string", "maxLength": 30 },
        "productId": { "type": "string", "maxLength": 64 },
        "productSnapshot": { "type": "object" },
        "totalAmount": { "type": "number" },
        "amountPaid": { "type": "number" },
        "remainingAmount": { "type": "number" },
        "progressPercentage": { "type": "number" },
        "duration": { "type": "number" },
        "frequency": { "type": "string", "maxLength": 20 },
        "monthlyPayment": { "type": "number" },
        "startDate": { "type": "string" },
        "expectedEndDate": { "type": "string" },
        "nextPaymentDueDate": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "active", "completed", "cancelled", "overdue"] },
        "deliveryStatus": { "type": "string", "enum": ["pending", "scheduled", "shipped", "delivered"] },
        "deliveryAddress": { "type": "string", "maxLength": 300 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["customerId", "productId", "totalAmount", "status", "duration"]
    },
    "InstallmentPayment": {
      "title": "InstallmentPayment",
      "description": "Individual payments made towards an installment contract",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "contractId": { "type": "string", "maxLength": 64 },
        "customerId": { "type": "string", "maxLength": 128 },
        "amount": { "type": "number" },
        "date": { "type": "string" },
        "method": { "type": "string", "maxLength": 50 },
        "reference": { "type": "string", "maxLength": 100 },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "recordedBy": { "type": "string", "maxLength": 150 },
        "notes": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string" }
      },
      "required": ["contractId", "customerId", "amount", "status", "reference"]
    },
    "TontineGroup": {
      "title": "TontineGroup",
      "description": "Rotational savings tontine groups with configurable member counts and periods",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "groupCode": { "type": "string", "maxLength": 32 },
        "name": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 1000 },
        "memberCount": { "type": "number" },
        "rotationPeriodDays": { "type": "number" },
        "totalDurationDays": { "type": "number" },
        "contributionFrequency": { "type": "string", "maxLength": 50 },
        "startDate": { "type": "string" },
        "endDate": { "type": "string" },
        "status": { "type": "string", "enum": ["draft", "open", "full", "active", "completed", "cancelled"] },
        "currentRotationPosition": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["groupCode", "name", "memberCount", "rotationPeriodDays", "totalDurationDays", "status"]
    },
    "TontineMember": {
      "title": "TontineMember",
      "description": "Member participation, distinct product, and allocated position in a tontine group",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "groupId": { "type": "string", "maxLength": 64 },
        "customerId": { "type": "string", "maxLength": 128 },
        "customerName": { "type": "string", "maxLength": 150 },
        "customerPhone": { "type": "string", "maxLength": 30 },
        "position": { "type": "number" },
        "productId": { "type": "string", "maxLength": 64 },
        "productSnapshot": { "type": "object" },
        "expectedContribution": { "type": "number" },
        "totalContributed": { "type": "number" },
        "remainingAmount": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "completed", "overdue", "cancelled"] },
        "beneficiaryDate": { "type": "string" },
        "deliveryStatus": { "type": "string", "enum": ["not_eligible", "pending", "scheduled", "shipped", "delivered"] },
        "joinedAt": { "type": "string" }
      },
      "required": ["groupId", "customerId", "position", "status"]
    },
    "TontineContribution": {
      "title": "TontineContribution",
      "description": "Individual payment of a tontine contribution (daily, grouped, partial, etc.)",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "groupId": { "type": "string", "maxLength": 64 },
        "memberId": { "type": "string", "maxLength": 64 },
        "customerId": { "type": "string", "maxLength": 128 },
        "amount": { "type": "number" },
        "date": { "type": "string" },
        "method": { "type": "string", "maxLength": 50 },
        "reference": { "type": "string", "maxLength": 100 },
        "status": { "type": "string", "enum": ["approved", "pending", "rejected"] },
        "paymentType": { "type": "string", "maxLength": 50 },
        "recordedBy": { "type": "string", "maxLength": 150 },
        "notes": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string" }
      },
      "required": ["groupId", "memberId", "customerId", "amount", "status"]
    },
    "TontineRotation": {
      "title": "TontineRotation",
      "description": "Round schedule and beneficiary assignment for a tontine group",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "groupId": { "type": "string", "maxLength": 64 },
        "position": { "type": "number" },
        "memberId": { "type": "string", "maxLength": 64 },
        "memberName": { "type": "string", "maxLength": 150 },
        "startDate": { "type": "string" },
        "endDate": { "type": "string" },
        "status": { "type": "string", "enum": ["upcoming", "current", "completed"] },
        "deliveryStatus": { "type": "string", "maxLength": 50 }
      },
      "required": ["groupId", "position", "memberId", "startDate", "endDate", "status"]
    },
    "Delivery": {
      "title": "Delivery",
      "description": "Delivery tracking for orders, installment completions, or tontine allocations",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "trackingNumber": { "type": "string", "maxLength": 32 },
        "sourceType": { "type": "string", "maxLength": 50 },
        "sourceId": { "type": "string", "maxLength": 64 },
        "customerId": { "type": "string", "maxLength": 128 },
        "recipientName": { "type": "string", "maxLength": 150 },
        "recipientPhone": { "type": "string", "maxLength": 30 },
        "city": { "type": "string", "maxLength": 100 },
        "commune": { "type": "string", "maxLength": 100 },
        "address": { "type": "string", "maxLength": 300 },
        "driverName": { "type": "string", "maxLength": 100 },
        "driverPhone": { "type": "string", "maxLength": 30 },
        "status": { "type": "string", "maxLength": 50 },
        "estimatedDate": { "type": "string" },
        "deliveredAt": { "type": "string" },
        "notes": { "type": "string", "maxLength": 500 }
      },
      "required": ["trackingNumber", "sourceType", "sourceId", "recipientName", "recipientPhone", "status"]
    },
    "AdminUser": {
      "title": "AdminUser",
      "description": "Administrator and operator accounts",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 150 },
        "fullName": { "type": "string", "maxLength": 150 },
        "role": { "type": "string", "maxLength": 50 },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "email", "role", "isActive"]
    },
    "ActivityLog": {
      "title": "ActivityLog",
      "description": "Audit and activity logs for administrative actions",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "userId": { "type": "string", "maxLength": 128 },
        "userEmail": { "type": "string", "maxLength": 150 },
        "action": { "type": "string", "maxLength": 100 },
        "entityType": { "type": "string", "maxLength": 50 },
        "entityId": { "type": "string", "maxLength": 64 },
        "details": { "type": "string", "maxLength": 2000 },
        "timestamp": { "type": "string" }
      },
      "required": ["userId", "action", "entityType", "timestamp"]
    }
  },
  "firestore": {
    "/categories/{categoryId}": {
      "schema": "Category",
      "description": "Product category documents"
    },
    "/products/{productId}": {
      "schema": "Product",
      "description": "Product catalog documents"
    },
    "/customers/{customerId}": {
      "schema": "Customer",
      "description": "Customer profile documents"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Order records for classic purchases"
    },
    "/installmentContracts/{contractId}": {
      "schema": "InstallmentContract",
      "description": "Installment credit contracts"
    },
    "/installmentPayments/{paymentId}": {
      "schema": "InstallmentPayment",
      "description": "Installment payments records"
    },
    "/tontineGroups/{groupId}": {
      "schema": "TontineGroup",
      "description": "Tontine groups"
    },
    "/tontineMembers/{memberId}": {
      "schema": "TontineMember",
      "description": "Tontine memberships and assigned slots"
    },
    "/tontineContributions/{contributionId}": {
      "schema": "TontineContribution",
      "description": "Contributions to tontines"
    },
    "/tontineRotations/{rotationId}": {
      "schema": "TontineRotation",
      "description": "Rotation and beneficiary assignment schedule"
    },
    "/deliveries/{deliveryId}": {
      "schema": "Delivery",
      "description": "Logistics and delivery records"
    },
    "/adminUsers/{adminId}": {
      "schema": "AdminUser",
      "description": "List of administrative users"
    },
    "/admins/{adminUid}": {
      "schema": "AdminUser",
      "description": "Lookup document for security rules admin verification"
    },
    "/activityLogs/{logId}": {
      "schema": "ActivityLog",
      "description": "System activity logs"
    }
  }
}
